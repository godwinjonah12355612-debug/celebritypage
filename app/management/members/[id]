"use client";

import { useEffect, useState } from "react";
import Link from "next/link";
import { useParams, useRouter } from "next/navigation";
import { createClient } from "@/lib/supabase/client";

type Member = {
  id: string;
  full_name: string | null;
  display_name: string | null;
  email: string | null;
  phone: string | null;
  country: string | null;
  timezone: string | null;
  language: string | null;
  avatar_url: string | null;
  role: string;
  status: string;
  last_login_at: string | null;
  created_at: string;
  updated_at: string;
};

const MANAGEMENT_ROLES = [
  "member",
  "staff",
  "manager",
  "administrator",
  "super_admin",
];

const STATUS_OPTIONS = [
  "active",
  "pending",
  "suspended",
  "deactivated",
];

export default function MemberProfilePage() {
  const params = useParams();
  const router = useRouter();
  const supabase = createClient();

  const memberId = Array.isArray(params.id)
    ? params.id[0]
    : params.id;

  const [member, setMember] = useState<Member | null>(null);
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [errorMessage, setErrorMessage] = useState("");
  const [successMessage, setSuccessMessage] = useState("");

  const [role, setRole] = useState("member");
  const [status, setStatus] = useState("active");

  useEffect(() => {
    if (memberId) {
      loadMember();
    }
  }, [memberId]);

  async function loadMember() {
    setLoading(true);
    setErrorMessage("");

    const { data, error } = await supabase
      .from("profiles")
      .select(`
        id,
        full_name,
        display_name,
        email,
        phone,
        country,
        timezone,
        language,
        avatar_url,
        role,
        status,
        last_login_at,
        created_at,
        updated_at
      `)
      .eq("id", memberId)
      .single();

    if (error) {
      console.error("MEMBER LOAD ERROR:", error);
      setErrorMessage(error.message);
      setLoading(false);
      return;
    }

    setMember(data);
    setRole(data.role);
    setStatus(data.status);
    setLoading(false);
  }

  async function handleSave() {
    if (!member) return;

    setSaving(true);
    setErrorMessage("");
    setSuccessMessage("");

    const { data, error } = await supabase
      .from("profiles")
      .update({
        role,
        status,
        updated_at: new Date().toISOString(),
      })
      .eq("id", member.id)
      .select(`
        id,
        full_name,
        display_name,
        email,
        phone,
        country,
        timezone,
        language,
        avatar_url,
        role,
        status,
        last_login_at,
        created_at,
        updated_at
      `)
      .single();

    if (error) {
      console.error("MEMBER UPDATE ERROR:", error);
      setErrorMessage(error.message);
      setSaving(false);
      return;
    }

    setMember(data);
    setRole(data.role);
    setStatus(data.status);

    setSuccessMessage("Member account updated successfully.");
    setSaving(false);
  }

  function formatDate(date: string | null) {
    if (!date) return "Never";

    return new Date(date).toLocaleDateString("en-US", {
      month: "long",
      day: "numeric",
      year: "numeric",
    });
  }

  function formatDateTime(date: string | null) {
    if (!date) return "Never";

    return new Date(date).toLocaleString("en-US", {
      dateStyle: "medium",
      timeStyle: "short",
    });
  }

  function formatRole(value: string) {
    return value
      .replaceAll("_", " ")
      .replace(/\b\w/g, (letter) => letter.toUpperCase());
  }

  function getDisplayName() {
    if (!member) return "Member";

    return (
      member.display_name ||
      member.full_name ||
      member.email?.split("@")[0] ||
      "Member"
    );
  }

  function getInitials() {
    const name = getDisplayName();

    return name
      .split(" ")
      .map((part) => part[0])
      .join("")
      .slice(0, 2)
      .toUpperCase();
  }

  function getStatusClasses(value: string) {
    switch (value) {
      case "active":
        return "bg-emerald-50 text-emerald-700 border-emerald-100";

      case "pending":
        return "bg-amber-50 text-amber-700 border-amber-100";

      case "suspended":
        return "bg-red-50 text-red-700 border-red-100";

      case "deactivated":
        return "bg-gray-100 text-gray-600 border-gray-200";

      default:
        return "bg-gray-100 text-gray-600 border-gray-200";
    }
  }

  if (loading) {
    return (
      <div className="min-h-screen bg-[#f6f6f3] px-6 py-10">
        <div className="mx-auto max-w-5xl">
          <div className="h-6 w-32 animate-pulse rounded bg-black/10" />

          <div className="mt-8 h-48 animate-pulse rounded-2xl bg-white" />

          <div className="mt-6 h-80 animate-pulse rounded-2xl bg-white" />
        </div>
      </div>
    );
  }

  if (!member) {
    return (
      <div className="min-h-screen bg-[#f6f6f3] px-6 py-20">
        <div className="mx-auto max-w-xl rounded-2xl border border-black/10 bg-white p-8 text-center">
          <h1 className="text-2xl font-semibold">
            Member not found
          </h1>

          <p className="mt-3 text-sm text-black/50">
            {errorMessage ||
              "The member account could not be found."}
          </p>

          <Link
            href="/management/members"
            className="mt-6 inline-flex rounded-full bg-black px-5 py-3 text-sm font-medium text-white"
          >
            Back to Members
          </Link>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-[#f6f6f3] text-black">
      {/* Header */}
      <header className="border-b border-black/10 bg-white">
        <div className="mx-auto max-w-[1400px] px-6 py-5 lg:px-10">
          <div className="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <div className="flex items-center gap-3 text-sm">
                <Link
                  href="/management"
                  className="text-black/40 transition hover:text-black"
                >
                  Management
                </Link>

                <span className="text-black/20">/</span>

                <Link
                  href="/management/members"
                  className="text-black/40 transition hover:text-black"
                >
                  Members
                </Link>

                <span className="text-black/20">/</span>

                <span>Profile</span>
              </div>

              <h1 className="mt-2 text-3xl font-semibold tracking-tight">
                Member Profile
              </h1>

              <p className="mt-1 text-sm text-black/50">
                View and manage this member account.
              </p>
            </div>

            <Link
              href="/management/members"
              className="inline-flex w-fit rounded-full border border-black/10 bg-white px-5 py-2.5 text-sm font-medium transition hover:border-black/30"
            >
              ← Back to Members
            </Link>
          </div>
        </div>
      </header>

      <main className="mx-auto max-w-[1400px] px-6 py-8 lg:px-10">
        {/* Messages */}
        {successMessage && (
          <div className="mb-6 rounded-2xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-sm text-emerald-700">
            {successMessage}
          </div>
        )}

        {errorMessage && (
          <div className="mb-6 rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm text-red-700">
            {errorMessage}
          </div>
        )}

        {/* Profile Hero */}
        <section className="overflow-hidden rounded-2xl border border-black/10 bg-white shadow-sm">
          <div className="h-32 bg-black" />

          <div className="px-6 pb-7 lg:px-8">
            <div className="-mt-12 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
              <div className="flex flex-col gap-4 sm:flex-row sm:items-end">
                <div className="flex h-24 w-24 shrink-0 items-center justify-center rounded-2xl border-4 border-white bg-black text-2xl font-semibold text-white shadow-lg">
                  {getInitials()}
                </div>

                <div className="pb-1">
                  <h2 className="text-2xl font-semibold">
                    {getDisplayName()}
                  </h2>

                  <p className="mt-1 text-sm text-black/45">
                    {member.email || "No email address"}
                  </p>
                </div>
              </div>

              <div className="flex flex-wrap gap-2">
                <span
                  className={`rounded-full border px-3 py-1.5 text-xs font-medium capitalize ${getStatusClasses(
                    member.status
                  )}`}
                >
                  {member.status}
                </span>

                <span className="rounded-full bg-black px-3 py-1.5 text-xs font-medium text-white">
                  {formatRole(member.role)}
                </span>
              </div>
            </div>
          </div>
        </section>

        <div className="mt-6 grid gap-6 lg:grid-cols-[1fr_380px]">
          {/* Member information */}
          <section className="rounded-2xl border border-black/10 bg-white shadow-sm">
            <div className="border-b border-black/10 px-6 py-5">
              <h2 className="text-lg font-semibold">
                Account Information
              </h2>

              <p className="mt-1 text-sm text-black/45">
                Personal and account details.
              </p>
            </div>

            <div className="grid gap-x-8 gap-y-6 p-6 sm:grid-cols-2">
              <InfoItem
                label="Full Name"
                value={member.full_name || "—"}
              />

              <InfoItem
                label="Display Name"
                value={member.display_name || "—"}
              />

              <InfoItem
                label="Email"
                value={member.email || "—"}
              />

              <InfoItem
                label="Phone"
                value={member.phone || "—"}
              />

              <InfoItem
                label="Country"
                value={member.country || "—"}
              />

              <InfoItem
                label="Timezone"
                value={member.timezone || "—"}
              />

              <InfoItem
                label="Language"
                value={member.language || "—"}
              />

              <InfoItem
                label="Member ID"
                value={member.id}
                mono
              />

              <InfoItem
                label="Registered"
                value={formatDateTime(member.created_at)}
              />

              <InfoItem
                label="Last Updated"
                value={formatDateTime(member.updated_at)}
              />

              <InfoItem
                label="Last Login"
                value={formatDateTime(member.last_login_at)}
              />
            </div>
          </section>

          {/* Account controls */}
          <section className="h-fit rounded-2xl border border-black/10 bg-white shadow-sm">
            <div className="border-b border-black/10 px-6 py-5">
              <h2 className="text-lg font-semibold">
                Account Controls
              </h2>

              <p className="mt-1 text-sm text-black/45">
                Manage role and account access.
              </p>
            </div>

            <div className="space-y-6 p-6">
              <div>
                <label className="mb-2 block text-sm font-medium">
                  Role
                </label>

                <select
                  value={role}
                  onChange={(event) =>
                    setRole(event.target.value)
                  }
                  className="w-full rounded-xl border border-black/10 bg-[#f8f8f6] px-4 py-3 text-sm outline-none focus:border-black/30"
                >
                  {MANAGEMENT_ROLES.map((item) => (
                    <option key={item} value={item}>
                      {formatRole(item)}
                    </option>
                  ))}
                </select>
              </div>

              <div>
                <label className="mb-2 block text-sm font-medium">
                  Account Status
                </label>

                <select
                  value={status}
                  onChange={(event) =>
                    setStatus(event.target.value)
                  }
                  className="w-full rounded-xl border border-black/10 bg-[#f8f8f6] px-4 py-3 text-sm outline-none focus:border-black/30"
                >
                  {STATUS_OPTIONS.map((item) => (
                    <option key={item} value={item}>
                      {formatRole(item)}
                    </option>
                  ))}
                </select>
              </div>

              <div className="rounded-xl bg-[#f6f6f3] p-4">
                <p className="text-xs font-medium uppercase tracking-[0.12em] text-black/40">
                  Access
                </p>

                <p className="mt-2 text-sm leading-6 text-black/60">
                  Changing the account status affects whether
                  the member can access the platform.
                </p>
              </div>

              <button
                onClick={handleSave}
                disabled={saving}
                className="w-full rounded-xl bg-black px-5 py-3.5 text-sm font-medium text-white transition hover:bg-black/80 disabled:cursor-not-allowed disabled:opacity-50"
              >
                {saving ? "Saving changes..." : "Save Changes"}
              </button>
            </div>
          </section>
        </div>

        {/* Account activity */}
        <section className="mt-6 rounded-2xl border border-black/10 bg-white shadow-sm">
          <div className="border-b border-black/10 px-6 py-5">
            <h2 className="text-lg font-semibold">
              Account Activity
            </h2>

            <p className="mt-1 text-sm text-black/45">
              Important account timestamps.
            </p>
          </div>

          <div className="grid gap-6 p-6 sm:grid-cols-3">
            <ActivityCard
              label="Account Created"
              value={formatDateTime(member.created_at)}
            />

            <ActivityCard
              label="Last Login"
              value={formatDateTime(member.last_login_at)}
            />

            <ActivityCard
              label="Last Updated"
              value={formatDateTime(member.updated_at)}
            />
          </div>
        </section>

        {/* Danger area */}
        <section className="mt-6 rounded-2xl border border-red-200 bg-white shadow-sm">
          <div className="border-b border-red-100 px-6 py-5">
            <h2 className="text-lg font-semibold text-red-700">
              Account Access
            </h2>

            <p className="mt-1 text-sm text-black/45">
              Use the account status above to restrict or restore
              access.
            </p>
          </div>

          <div className="p-6">
            <div className="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <p className="font-medium">
                  {member.status === "active"
                    ? "This account is active"
                    : "This account is not active"}
                </p>

                <p className="mt-1 text-sm text-black/45">
                  Current status:{" "}
                  <span className="font-medium capitalize">
                    {member.status}
                  </span>
                </p>
              </div>

              <button
                onClick={() =>
                  setStatus(
                    member.status === "active"
                      ? "suspended"
                      : "active"
                  )
                }
                className={`rounded-xl px-5 py-3 text-sm font-medium transition ${
                  member.status === "active"
                    ? "border border-red-200 bg-red-50 text-red-700 hover:bg-red-100"
                    : "bg-black text-white hover:bg-black/80"
                }`}
              >
                {member.status === "active"
                  ? "Suspend Account"
                  : "Reactivate Account"}
              </button>
            </div>
          </div>
        </section>
      </main>
    </div>
  );
}

function InfoItem({
  label,
  value,
  mono = false,
}: {
  label: string;
  value: string;
  mono?: boolean;
}) {
  return (
    <div>
      <p className="text-xs font-medium uppercase tracking-[0.1em] text-black/35">
        {label}
      </p>

      <p
        className={`mt-2 break-words text-sm text-black/75 ${
          mono ? "font-mono text-xs" : ""
        }`}
      >
        {value}
      </p>
    </div>
  );
}

function ActivityCard({
  label,
  value,
}: {
  label: string;
  value: string;
}) {
  return (
    <div className="rounded-xl bg-[#f6f6f3] p-5">
      <p className="text-xs font-medium uppercase tracking-[0.1em] text-black/35">
        {label}
      </p>

      <p className="mt-3 text-sm font-medium">
        {value}
      </p>
    </div>
  );
}
